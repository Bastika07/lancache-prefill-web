<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\LancachePrefill.Core\LancachePrefill.Core.csproj" />
    <ProjectReference Include="..\LancachePrefill.Modules.Steam\LancachePrefill.Modules.Steam.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.8.1" />
  </ItemGroup>

  <PropertyGroup>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- The SDK only infers this when .razor files exist at restore time. The Dockerfile restores from
         the project files alone, so without it blazor.web.js is missing and the UI is not interactive. -->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
  </PropertyGroup>

</Project>
