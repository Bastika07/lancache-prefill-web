@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization

<AuthorizeView>
    <Authorized>
        <header class="app-header">
            <span class="brand">🎮 Lancache Prefill</span>
            <nav aria-label="Main">
                <NavLink href="" Match="NavLinkMatch.All">Dashboard</NavLink>
                <NavLink href="jobs">Jobs</NavLink>
                <NavLink href="schedules">Schedules</NavLink>
                <NavLink href="steam">Steam</NavLink>
            </nav>
            <form method="post" action="/logout" class="inline">
                <AntiforgeryToken />
                <button type="submit" class="sign-out">Sign out</button>
            </form>
        </header>
        <main class="container">
            @Body
        </main>
    </Authorized>
    <NotAuthorized>
        @Body
    </NotAuthorized>
</AuthorizeView>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
