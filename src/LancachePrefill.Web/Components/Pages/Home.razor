@page "/"
@using LancachePrefill.Core.Lancache
@using LancachePrefill.Core.Persistence
@inject LancacheDetector Detector
@inject PrefillDatabase Db

<PageTitle>Dashboard · Lancache Prefill</PageTitle>

<h1>Dashboard</h1>

<section aria-labelledby="lancache-heading">
    <h2 id="lancache-heading">Lancache</h2>
    @switch (_status)
    {
        case null:
            <p>Looking for the Lancache…</p>
            break;
        case LancacheStatus.Found found:
            <p class="ok" data-testid="lancache-found">Using Lancache at <strong>@found.Address</strong> (via @found.Source).</p>
            break;
        case LancacheStatus.NotFound notFound:
            <p class="warning" role="alert" data-testid="lancache-not-found">
                <strong>No Lancache found.</strong> @notFound.Reason
            </p>
            break;
    }
</section>

<p><a href="/steam">Steam account and prefill</a></p>

<form method="post" action="/logout">
    <AntiforgeryToken />
    <button type="submit">Sign out</button>
</form>

@code {
    private LancacheStatus? _status;

    protected override async Task OnInitializedAsync()
    {
        var settings = await Db.Settings.GetGlobalAsync(CancellationToken.None);
        _status = await Detector.DetectAsync(settings.LancacheIpOverride, CancellationToken.None);
    }
}
