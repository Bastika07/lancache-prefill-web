@page "/steam"
@rendermode InteractiveServer
@using LancachePrefill.Core
@using LancachePrefill.Modules.Steam
@using LancachePrefill.Web.Components.Steam
@implements IDisposable
@inject JobQueue Queue
@inject ISteamLogin Login

<PageTitle>Steam · Lancache Prefill</PageTitle>

<h1>Steam</h1>

<SteamLoginDialog />

@if (Login.State is SteamLoginState.SignedIn)
{
    @* Temporary until Selections (#10) and the Job view (#7): prefill app ids right now. *@
    <section aria-labelledby="prefill-now-heading">
        <h2 id="prefill-now-heading">Prefill now</h2>
        <form @onsubmit="Enqueue">
            <label for="app-ids">Steam app ids (comma separated)</label>
            <input id="app-ids" @bind="_appIds" placeholder="e.g. 440, 570" />
            <fieldset>
                <legend>Dynamic rules</legend>
                <label><input type="checkbox" @bind="_allOwned" /> All owned games</label>
                <label><input type="checkbox" @bind="_recentlyPlayed" /> Recently played (2 weeks)</label>
                <label><input type="checkbox" @bind="_recentlyPurchased" /> Recently purchased (30 days)</label>
                <label><input type="checkbox" @bind="_topPopular" /> Top <input type="number" min="1" max="100" @bind="_topCount" style="width:4em" /> popular</label>
            </fieldset>
            <label><input type="checkbox" @bind="_force" /> Force (download even if up to date)</label>
            <button type="submit">Prefill</button>
        </form>
        @if (LatestJob is { } job)
        {
            <dl data-testid="job-status">
                <dt>Latest Job</dt>
                <dd>
                    <span class="badge @Jobs.StateBadge(job.State)">@job.State</span>
                    <a href="@($"jobs/{job.Id}")">Details and log →</a>
                </dd>
                @if (job.Progress is { } p && job.State == JobState.Running)
                {
                    <dt>Progress</dt>
                    <dd>@p.Phase @p.CurrentGameId @(p.BytesTotal > 0 ? $"{JobFormat.Bytes(p.BytesDone)} / {JobFormat.Bytes(p.BytesTotal)}" : "")</dd>
                }
                @if (job.ResolvedGameIds is { } resolved)
                {
                    <dt>Games</dt><dd>@resolved.Count: @string.Join(", ", resolved.Take(20))@(resolved.Count > 20 ? ", …" : "")</dd>
                }
            </dl>
        }
    </section>
}

@code {
    private string _appIds = "";
    private bool _force;
    private bool _allOwned, _recentlyPlayed, _recentlyPurchased, _topPopular;
    private int _topCount = 10;

    // The queue outlives the page, so a reload still shows the latest Steam Job.
    private Job? LatestJob => Queue.Jobs.LastOrDefault(j => j.ModuleId == SteamPrefillModule.ModuleId);
    private Timer? _refresh;

    protected override void OnInitialized()
    {
        Login.StateChanged += Refresh;
        _refresh = new Timer(_ => Refresh(), null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    private void Refresh() => InvokeAsync(StateHasChanged);

    private void Enqueue()
    {
        var ids = _appIds.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        var rules = new List<SelectionRule>();
        if (_allOwned) rules.Add(SelectionRule.AllOwned);
        if (_recentlyPlayed) rules.Add(SelectionRule.RecentlyPlayed);
        if (_recentlyPurchased) rules.Add(SelectionRule.RecentlyPurchased);
        if (_topPopular) rules.Add(SelectionRule.TopPopular(Math.Max(1, _topCount)));
        Queue.Enqueue(SteamPrefillModule.ModuleId, new PrefillRequest(ids, _force, rules));
    }

    public void Dispose()
    {
        Login.StateChanged -= Refresh;
        _refresh?.Dispose();
    }
}
