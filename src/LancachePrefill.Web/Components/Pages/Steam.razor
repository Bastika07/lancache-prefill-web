@page "/steam"
@rendermode InteractiveServer
@using LancachePrefill.Core
@using LancachePrefill.Modules.Steam
@using LancachePrefill.Web.Components.Selections
@using LancachePrefill.Web.Components.Steam
@implements IDisposable
@inject ISteamLogin Login
@inject IEnumerable<IPrefillModule> Modules

<PageTitle>Steam · Lancache Prefill</PageTitle>

<h1>Steam</h1>

<SteamLoginDialog />

@if (Login.State is SteamLoginState.SignedIn)
{
    @* Re-created after the settings change: the Game list depends on the operating systems. *@
    <SelectionEditor @key="_settingsVersion" Module="@SteamModule" />
}

<SteamSettingsForm OnSaved="() => _settingsVersion++" />

@code {
    private int _settingsVersion;

    private IPrefillModule SteamModule => Modules.Single(m => m.Id == SteamPrefillModule.ModuleId);

    protected override void OnInitialized() => Login.StateChanged += Refresh;

    private void Refresh() => InvokeAsync(StateHasChanged);

    public void Dispose() => Login.StateChanged -= Refresh;
}
