root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,props,csproj,slnx,razor,css}]
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
dotnet_style_qualification_for_field = false:suggestion
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion

# Glossary terms win over naming heuristics ("Job queue").
dotnet_diagnostic.CA1711.severity = none

[tests/**.cs]
# Test names read as sentences: Enqueued_job_runs_its_module_...
dotnet_diagnostic.CA1707.severity = none

[src/**/Migrations/*.cs]
# EF Core generates these; don't hold them to hand-written code rules.
generated_code = true
dotnet_analyzer_diagnostic.severity = none
